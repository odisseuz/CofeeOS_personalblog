env/

# variáveis de ambiente / segredos
.env
.env.*

# logs / temporários
*.log
*.tmp

# pacotes de ícones baixados (não versionados) — NÃO use padrões que casem
# assets/icons/, que É versionado
*.zip
*.zip.download/
*.tar.gz
papirus-icon-theme*

# gerados pelo build.js (SEO + robots com o dominio do BASE_URL)
