robots.txt
posts/**/*.html
posts/index.json

# pacotes de libs baixados pra vendorizar (o conteudo ja esta em js/vendor/)
*.tgz

# testes temporarios na raiz (nao devem ser commitados)
_*.mjs
_*.html

# drafts de posts: ficam no disco, nao sobem pro GitHub.
# quando o texto estiver pronto, comente esta linha, registre no manifest e commite.
posts/science/causal-inference/
posts/science/psychology/
