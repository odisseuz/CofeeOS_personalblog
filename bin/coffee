#!/usr/bin/env bash
#
# coffee — CLI do midnight coffee
#
#   coffee new <grupo>/[subpasta/]nome.md   cria o .md e registra no manifest
#   coffee rm  <grupo>/[subpasta/]nome.md   remove o .md e tira do manifest
#   coffee ls [grupo]                       lista os posts
#   coffee status                           visão geral
#   coffee check                            valida (igual ao CI)
#   coffee images                           checa metadados (EXIF) em images/
#   coffee serve [porta]                    servidor local, sem cache
#
# Bash 3.2 (o do macOS) + python3 (que o build já usa).

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
POSTS="$ROOT/posts"
MANIFEST="$POSTS/manifest.json"
TOOL="$ROOT/bin/lib/manifest_tool.py"
DRAFTS="$ROOT/bin/lib/drafts_tool.py"
COMMIT="$ROOT/bin/lib/commit_tool.py"
STATUS="$ROOT/bin/lib/status_tool.py"

# os grupos são os que estão na home (index.html) — assim um grupo novo é
# reconhecido na hora, sem editar o script.
groups() {
  grep -o 'data-group="[a-z0-9-]*"' "$ROOT/index.html" 2>/dev/null \
    | sed 's/data-group="//; s/"//' | tr '\n' ' '
}

die() { printf 'coffee: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
coffee — midnight coffee

escrever
  new <grupo>/[subpasta/]nome.md   cria o .md e registra no manifest
  rm  <grupo>/[subpasta/]nome.md   remove o .md e tira do manifest
  publish <grupo>/[.../]nome.md    tira o draft e registra no manifest

ver
  (sem argumento)                  estado do projeto + menu
  status                           o mesmo estado, sem menu
  ls [grupo]                       lista os posts (título e data)
  drafts                           lista os rascunhos (draft: true)

publicar
  commit [-m msg]                  .gitignore + manifest + add + commit (+ push?)
  verify                           roda todas as checagens
  check                            valida manifest + frontmatter (igual ao CI)
  images                           checa metadados (EXIF/GPS) em images/
  serve [porta]                    servidor local, sem cache (padrão 8000)

  -h, --help                       esta ajuda
EOF
}

# ---------- modo interativo ----------

# a tela de estado: é ela que responde "o que eu faço agora?", que o --help
# não responde. Os dados vêm do status_tool (texto plano, testável).
#
# `< /dev/null` em todo python3: sem isso o pipe do `while read` consome o stdin
# do terminal, e o `read` do menu nunca recebe a escolha.
tela_status() {
  local resumo
  resumo="$(python3 "$STATUS" resumo 2>/dev/null < /dev/null)" || return 0
  printf '\nmidnight coffee\n\n'
  printf '%s\n' "$resumo" | while IFS='|' read -r chave valor; do
    case "$chave" in
      posts)     printf '  posts        %s\n' "$valor" ;;
      idiomas)   printf '  idiomas      %s\n' "$valor" ;;
      git)       printf '  git          %s\n' "$valor" ;;
      grupos)    printf '  grupos       %s\n' "$valor" ;;
      rascunhos) printf '\n  rascunhos:\n' ;;
      '  '*)     printf '    %s\n' "$(printf '%s' "$chave" | sed 's/^ *//')" ;;
      proximo)   printf '\n  próximo passo:\n    %s\n' "$valor" ;;
      porque)    printf '    (%s)\n\n' "$valor" ;;
      *)         [ -n "$chave" ] && printf '%s\n' "$chave" ;;
    esac
  done
}

# lê uma opção do menu. Aceita o NÚMERO e a TECLA (a primeira letra do
# comando), porque quem usa muito decora a letra e quem chega de fora lê o
# número. `q`/Enter vazio saem.
ler_opcao() {
  # o prompt vai pro stderr: quem chama usa $( ) pra capturar só a resposta,
  # e sem isso o texto do prompt entra junto (era o bug do menu não responder).
  printf '  escolha (número ou letra, Enter sai): ' >&2
  local escolha
  read -r escolha || return 1
  case "$escolha" in
    ''|q|Q|sair) return 1 ;;
    *[!0-9]*) printf '%s' "$(printf '%s' "$escolha" | tr 'A-Z' 'a-z' | cut -c1)" ;;
    *) printf '%s' "$escolha" ;;
  esac
}

cmd_menu() {
  while :; do
    tela_status
    printf '  o que você quer fazer?\n\n'
    python3 "$STATUS" menu 2>/dev/null < /dev/null | while IFS='|' read -r tecla rotulo _cmd; do
      printf '    %s) %s\n' "$tecla" "$rotulo"
    done
    printf '\n'

    local op
    op="$(ler_opcao)" || { printf '\n'; return 0; }

    # resolve a opção pelo NÚMERO (tecla) ou pela LETRA inicial do comando.
    # O menu vem do status_tool como "tecla|rótulo|comando", então a busca é uma
    # comparação de texto só — sem case aninhado dentro de substituição, que o
    # bash 3.2 não engole.
    local menu alvo
    menu="$(python3 "$STATUS" menu 2>/dev/null < /dev/null)"
    alvo="$(printf '%s\n' "$menu" | awk -F'|' -v op="$op" '
      $1 == op { print $3; encontrou = 1; exit }
      !encontrou && index($3, op) == 1 { print $3; encontrou = 1; exit }
    ')"

    if [ -z "$alvo" ]; then
      printf '\n  não entendi "%s".\n' "$op"
      sleep 1
      continue
    fi

    local cmd="$alvo"
    printf '\n'
    case "$cmd" in
      new)     menu_new ;;
      drafts)  cmd_drafts ;;
      publish) menu_publish ;;
      commit)  cmd_commit ;;
      serve)   menu_serve ;;
      verify)  cmd_verify ;;
      ls)      cmd_ls ;;
      help)    usage ;;
      *)       printf '  (%s ainda não está no menu)\n' "$cmd" ;;
    esac
    printf '\n'
    printf '  Enter pra voltar '
    read -r _ || return 0
  done
}

# pede os dados que faltam, em vez de exigir que a pessoa saiba a sintaxe
menu_new() {
  printf '  caminho do post (ex.: science/education/meu-post): '
  local rel
  read -r rel || return 0
  [ -n "$rel" ] || return 0
  printf '  idioma [[en]/pt]: '
  local lang
  read -r lang || lang=""
  printf '  começar como rascunho? [S/n]: '
  local dr
  read -r dr || dr=""
  local flags=""
  [ -n "$lang" ] && flags="$flags --lang $lang"
  case "$dr" in n|N) ;; *) flags="$flags --draft" ;; esac
  # shellcheck disable=SC2086
  cmd_new $flags "$rel"
}

menu_publish() {
  local ds
  ds="$(python3 "$DRAFTS" list 2>/dev/null < /dev/null)"
  if [ -z "$ds" ]; then
    printf '  nenhum rascunho pra publicar\n'
    return 0
  fi
  printf '  rascunhos:\n'
  local i=1
  while IFS= read -r linha; do
    [ -n "$linha" ] || continue
    local limpo
    limpo="$(printf '%s' "$linha" | sed 's/  (.*//' | sed 's|^ *posts/||' | sed 's/^ *//; s/ *$//')"
    printf '    %s) %s\n' "$i" "$limpo"
    i=$((i + 1))
  done <<< "$ds"
  printf '  qual? (número, Enter cancela): '
  local n
  read -r n || return 0
  case "$n" in ''|*[!0-9]*) return 0 ;; esac
  local alvo
  alvo="$(printf '%s\n' "$ds" | sed -n "${n}p" | sed 's/  (.*//' | sed 's|posts/||')"
  [ -n "$alvo" ] && cmd_publish "$alvo"
}

menu_serve() {
  local porta="${COFFEE_PORT:-8090}"
  printf '  porta [%s]: ' "$porta"
  local p
  read -r p || p=""
  [ -n "$p" ] && porta="$p"
  cmd_serve "$porta"
}

# aceita "science/x.md", "posts/science/x.md", "/science/x.md", sem o .md
norm() {
  local p="$1"
  p="${p#posts/}"; p="${p#/}"
  case "$p" in *.md) ;; *) p="$p.md" ;; esac
  printf '%s' "$p"
}

cmd_new() {
  # flags em QUALQUER posição: `coffee new --lang pt x` e `coffee new x --lang pt`
  # valem o mesmo. Parar no primeiro argumento solto (o caminho) deixaria
  # `--lang` sem efeito — e o usuário não teria como saber.
  local lang="" draft=0 posicional=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --lang) lang="${2:-}"; shift 2 ;;
      --draft) draft=1; shift ;;
      -h|--help) printf 'uso: coffee new [--lang en|pt] [--draft] <grupo>/[subpasta/]nome.md\n'; return 0 ;;
      -*) die "opção desconhecida: $1" ;;
      *) [ -z "$posicional" ] && posicional="$1"; shift ;;
    esac
  done
  set -- "$posicional"

  [ $# -ge 1 ] && [ -n "$1" ] || die "uso: coffee new [--lang en|pt] [--draft] <grupo>/[subpasta/]nome.md"
  local rel group inner abs
  rel="$(norm "$1")"
  group="${rel%%/*}"
  inner="${rel#*/}"
  abs="$POSTS/$rel"

  [ "$group" != "$rel" ] || die "comece com um grupo (ex.: science/meu-post.md)"
  [ -e "$abs" ] && die "já existe: posts/$rel"

  case " $lang" in
    " " ) ;;
    " en"|" pt") ;;
    *) die "--lang aceita en ou pt (recebi: $lang)" ;;
  esac

  case " $(groups) " in
    *" $group "*) ;;
    *) printf 'aviso: "%s" não é um grupo da home (%s)\n' "$group" "$(groups)" >&2
       printf 'continuar? [y/N] ' >&2
       read -r ans
       case "$ans" in y|Y) ;; *) die "cancelado" ;; esac ;;
  esac

  mkdir -p "$(dirname "$abs")"
  # o frontmatter já sai com o que a pessoa pediu: `lang` (en é o padrão e pode
  # ser omitido) e `draft`, pra não esquecer nenhum dos dois depois.
  {
    printf -- '---\n'
    printf 'title: %s\n' "$(basename "$rel" .md)"
    printf 'date: %s\n' "$(date +%Y-%m-%d)"
    [ -n "$lang" ] && [ "$lang" != "en" ] && printf 'lang: %s\n' "$lang"
    [ "$draft" = 1 ] && printf 'draft: true\n'
    printf -- '---\n\n'
  } > "$abs"

  # rascunho não entra no manifest (o `publish` registra depois)
  if [ "$draft" = 0 ]; then
    local has=0
    python3 "$TOOL" has "$rel" || has=$?
    [ "$has" = 2 ] && die "criei o arquivo, mas posts/manifest.json está inválido — corrija e registre manualmente"
    if [ "$has" = 1 ]; then
      python3 "$TOOL" add "$group" "$inner" || die "criei o arquivo, mas falhei ao registrar no manifest — confira posts/manifest.json"
    fi
  fi

  printf 'criado: posts/%s\n' "$rel"
  [ "$draft" = 1 ] && printf '  (rascunho: não aparece no site nem entra no git)\n'
}

cmd_rm() {
  [ $# -ge 1 ] || die "uso: coffee rm <grupo>/[subpasta/]nome.md"
  local rel abs dir
  rel="$(norm "$1")"
  abs="$POSTS/$rel"
  [ -f "$abs" ] || die "não encontrei: posts/$rel"

  rm -f "$abs"
  # tira do manifest; se o manifest estiver inválido, avisa (o arquivo já foi removido)
  local has=0
  python3 "$TOOL" has "$rel" || has=$?
  [ "$has" = 2 ] && die "removi o arquivo, mas posts/manifest.json está inválido — tire a entrada manualmente"
  if [ "$has" = 0 ]; then
    python3 "$TOOL" remove "$rel" || die "removi o arquivo, mas falhei ao atualizar o manifest — confira posts/manifest.json"
  fi

  dir="$(dirname "$abs")"          # limpa subpastas que ficaram vazias
  while [ "$dir" != "$POSTS" ] && [ -d "$dir" ]; do
    rmdir "$dir" 2>/dev/null || break
    dir="$(dirname "$dir")"
  done
  printf 'removido: posts/%s\n' "$rel"
}

cmd_ls() {
  python3 - "$MANIFEST" "${1:-}" <<'PY'
import json, os, re, sys
manifest, only = sys.argv[1], sys.argv[2]
data = json.load(open(manifest, encoding="utf-8"))
base = os.path.dirname(manifest)
rows = []
for g, items in data.items():
    if only and g != only:
        continue
    for it in items:
        p = os.path.join(base, g, it)
        title = date = ""
        try:
            m = re.match(r"^---\n(.*?)\n---", open(p, encoding="utf-8").read(), re.S)
            for line in (m.group(1).splitlines() if m else []):
                k, _, v = line.partition(":")
                # value entre aspas (titulo com `:` precisa delas): tira as aspas
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                    v = v[1:-1]
                if k.strip() == "title": title = v
                if k.strip() == "date": date = v
        except OSError:
            pass
        rows.append((g, it, title or it, date))
if not rows:
    print("(nenhum post" + (f" em {only}" if only else "") + ")")
    sys.exit(0)
for g, it, title, date in sorted(rows):
    print(f"{g:<10} {date:<12} {title}")
    print(f"  {g}/{it}")
PY
}

cmd_check() {
  python3 "$ROOT/.github/scripts/check_manifest.py"
}

cmd_drafts() {
  python3 "$DRAFTS" list
}

# publica: tira o `draft:` do frontmatter e registra no manifest. O sync do
# .gitignore acontece depois, no commit (a linha sai do bloco gerado).
cmd_publish() {
  [ $# -ge 1 ] || die "uso: coffee publish <grupo>/[subpasta/]nome.md"
  local rel group inner
  rel="$(norm "$1")"
  group="${rel%%/*}"
  inner="${rel#*/}"
  python3 "$DRAFTS" publish "$rel" || exit 1
  python3 "$TOOL" has "$rel" || {
    python3 "$TOOL" add "$group" "$inner" || die "publiquei o arquivo, mas falhei ao registrar no manifest"
    printf 'registrado no manifest: %s\n' "$rel"
  }
}

# O caminho normal pra commitar. A ferramenta é dona do estado dos drafts:
#  1. lê o frontmatter e reescreve o bloco de drafts do .gitignore
#  2. registra no manifest os posts publicados que ainda não estavam
#  3. git add do resto, commit, e pergunta do push
cmd_commit() {
  local msg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -m) msg="${2:-}"; shift 2 ;;
      *) die "argumento desconhecido: $1 (uso: coffee commit [-m msg])" ;;
    esac
  done

  [ -d "$ROOT/.git" ] || die "não é um repositório git"

  local saida
  saida="$(COFFEE_MSG="$msg" python3 "$COMMIT" 2>&1)" || {
    local st=$?
    printf '%s\n' "$saida" >&2
    [ "$st" = 10 ] && return 0
    die "o commit falhou (código $st)"
  }
  printf '%s\n' "$saida" | grep -v '^MSG::'
  msg="$(printf '%s\n' "$saida" | sed -n 's/^MSG:://p')"
  [ -n "$msg" ] || return 0

  printf 'commitar? [Y/n] '
  read -r ans
  case "$ans" in n|N) die "cancelado" ;; esac

  git -C "$ROOT" commit -q -m "$msg" || die "o commit falhou"
  printf 'commitado: %s\n' "$(git -C "$ROOT" --no-pager log --oneline -1)"

  local branch ahead
  branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)"
  if git -C "$ROOT" rev-parse --abbrev-ref "$branch@{upstream}" > /dev/null 2>&1; then
    ahead="$(git -C "$ROOT" rev-list --count "$branch@{upstream}..$branch")"
    if [ "$ahead" -gt 0 ]; then
      printf 'push pra origin/%s? [Y/n] ' "$branch"
      read -r ans
      case "$ans" in n|N) printf 'sem push\n' ;; *) git -C "$ROOT" push origin "$branch" ;; esac
    fi
  else
    printf 'branch sem upstream — push manual: git push -u origin %s\n' "$branch"
  fi
}

cmd_images() {
  python3 "$ROOT/.github/scripts/check_images.py"
}

cmd_status() {
  python3 "$STATUS" resumo 2>/dev/null | while IFS='|' read -r chave valor; do
    case "$chave" in
      posts)     printf 'posts        %s\n' "$valor" ;;
      idiomas)   printf 'idiomas      %s\n' "$valor" ;;
      git)       printf 'git          %s\n' "$valor" ;;
      grupos)    printf 'grupos       %s\n' "$valor" ;;
      rascunhos) printf '\nrascunhos:\n' ;;
      proximo)   printf '\npróximo passo:\n  %s\n' "$valor" ;;
      porque)    printf '  (%s)\n' "$valor" ;;
      *)         [ -n "$chave" ] && printf '%s\n' "$chave" ;;
    esac
  done
  cmd_check || true
}

# roda tudo que dava pra esquecer antes de commitar. Cada passo falha
# independente, e no fim sai o resumo. Sem flags, sem opções.
cmd_verify() {
  local failed=0
  step() { printf '%-32s' "$1"; }

  step "bash"; if bash -n "$ROOT/bin/coffee" 2>/dev/null && bash -n "$ROOT/.github/scripts/check_cli.sh" 2>/dev/null; then echo "ok"; else echo "FALHOU"; failed=1; fi
  step "python"; if python3 -m py_compile "$ROOT/bin/lib/manifest_tool.py" "$ROOT/bin/lib/drafts_tool.py" "$ROOT/bin/lib/commit_tool.py" "$ROOT/bin/lib/status_tool.py" "$ROOT/bin/serve" 2>/dev/null; then echo "ok"; else echo "FALHOU"; failed=1; fi
  step "js"; local jsok=1; for f in "$ROOT"/js/*.js "$ROOT"/*.js; do node --check "$f" 2>/dev/null || jsok=0; done; [ "$jsok" = 1 ] && echo "ok" || { echo "FALHOU"; failed=1; }
  step "manifest + frontmatter"; if python3 "$ROOT/.github/scripts/check_manifest.py" > /dev/null 2>&1; then echo "ok"; else echo "FALHOU"; failed=1; fi
  # um `draft: true` que o git está rastreando subiria pro GitHub (era o papel
  # do .gitignore por pasta; agora o bloco é gerado, e isto confere o resultado).
  step "drafts fora do git"; local dr
  dr="$(python3 "$DRAFTS" staged 2>/dev/null)" || true
  if [ -z "$dr" ]; then echo "ok"; else echo "FALHOU"; echo "$dr" | sed 's/^/    rastreado: /'; failed=1; fi
  step "testes da CLI"; if bash "$ROOT/.github/scripts/check_cli.sh" > /dev/null 2>&1; then echo "ok"; else echo "FALHOU"; failed=1; fi
  step "testes do markdown"; if node "$ROOT/.github/scripts/check_render.js" > /dev/null 2>&1; then echo "ok"; else echo "FALHOU"; failed=1; fi
  step "imports"; local impok=1
  if ! node "$ROOT/.github/scripts/check_imports.mjs" > /tmp/coffee-imports.$$ 2>&1; then impok=0; fi
  if [ "$impok" = 1 ]; then echo "ok"; else echo "FALHOU"; sed 's/^/    /' /tmp/coffee-imports.$$; failed=1; fi
  rm -f /tmp/coffee-imports.$$
  step "metadados de imagem"; if python3 "$ROOT/.github/scripts/check_images.py" > /dev/null 2>&1; then echo "ok"; else echo "FALHOU"; failed=1; fi
  step "build + SEO"; local buildok=1
  ( cd "$ROOT" && BASE_URL=https://odisseuz.github.io/CofeeOS_personalblog node build.js > /dev/null 2>&1 ) || buildok=0
  if [ "$buildok" = 1 ]; then echo "ok"; else echo "FALHOU"; failed=1; fi
  rm -f "$ROOT/sitemap.xml" "$ROOT/posts/index.json"; find "$ROOT/posts" -name '*.html' -delete 2>/dev/null
  # arquivos do site que o git estaria ignorando (foi assim que o lucide* passou).
  # ignora os artefatos que devem mesmo ser ignorados (.pyc, index.json, etc).
  step "gitignore"
  local hidden=""
  hidden=$(cd "$ROOT" && find index.html style.css js assets bin -type f 2>/dev/null \
    | grep -v '__pycache__' \
    | grep -v '\.pyc$' \
    | while read -r p; do
        if git check-ignore -q "$p" 2>/dev/null; then echo "$p"; fi
      done) || true
  if [ -z "$hidden" ]; then
    echo "ok"
  else
    echo "FALHOU"
    echo "$hidden" | sed 's/^/    ignorado: /'
    failed=1
  fi

  # Safari não navega por Tab entre <button> sem tabindex explícito. Checa o
  # HTML estático e os pontos de runtime que criam botão.
  step "tabindex (botões)"
  local semti
  semti=$(python3 - "$ROOT" <<'PY'
import re, sys, os
root = sys.argv[1]
faltando = []
for rel in ['index.html']:
    p = os.path.join(root, rel)
    if not os.path.isfile(p):
        continue
    src = open(p, encoding='utf-8').read()
    for m in re.finditer(r'<button\b[^>]*>', src):
        if 'tabindex' not in m.group(0):
            linha = src[:m.start()].count('\n') + 1
            faltando.append(f'{rel}:{linha}')
print('\n'.join(faltando))
PY
) || true
  if [ -z "$semti" ]; then
    echo "ok"
  else
    echo "FALHOU"
    echo "$semti" | sed 's/^/    <button> sem tabindex: /'
    failed=1
  fi

  rm -rf "$ROOT/bin/lib/__pycache__" "$ROOT/bin/__pycache__" "$ROOT/__pycache__"
  echo
  [ "$failed" = 0 ] && echo "tudo ok" || { echo "algo falhou"; return 1; }
}

cmd_serve() {
  local port="${1:-8000}"
  lsof -i ":$port" > /dev/null 2>&1 && die "porta $port em uso (tente: coffee serve 8080)"
  printf 'servindo http://localhost:%s (Ctrl+C para parar)\n' "$port"
  python3 "$ROOT/bin/serve" "$port"
}

[ $# -ge 1 ] || { cmd_menu; exit 0; }
cmd="$1"; shift
case "$cmd" in
  new)    cmd_new "$@" ;;
  rm)     cmd_rm "$@" ;;
  ls)     cmd_ls "$@" ;;
  status) cmd_status "$@" ;;
  menu)   cmd_menu "$@" ;;
  check)  cmd_check "$@" ;;
  drafts) cmd_drafts "$@" ;;
  publish) cmd_publish "$@" ;;
  commit) cmd_commit "$@" ;;
  images) cmd_images "$@" ;;
  verify) cmd_verify "$@" ;;
  serve)  cmd_serve "$@" ;;
  -h|--help|help) usage ;;
  *) die "comando desconhecido: $cmd (tente: coffee help)" ;;
esac
